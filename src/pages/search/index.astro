---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { baseUrl } from '../../helpers.astro';
---

<BaseLayout title="Search Materials & Slides - COS 3100">
  <div class="search-page-container">
    <div class="search-hero framed">
      <div class="hero-header">
        <span class="terminal-badge">COS 3100 ARCHIVE</span>
        <h1 class="page-title">Course Material & Slide Search</h1>
        <p class="hero-desc">
          Search across <strong>330+ interactive Reveal.js slides</strong>, 13 comprehensive lessons,
          homework guides, bonus topics, and bash/git code snippets.
        </p>
      </div>

      <div class="search-box-wrapper">
        <div class="search-input-group">
          <span class="prompt-symbol">$</span>
          <input
            type="text"
            id="search-input"
            class="search-input"
            placeholder="Search keywords, commands, concepts (e.g. 'rebase', 'staging', 'detached HEAD', 'chmod')..."
            autocomplete="off"
            spellcheck="false"
            autofocus
          />
          <button id="clear-search-btn" class="clear-btn" title="Clear search" style="display: none;">✕</button>
        </div>
        <div class="search-shortcuts">
          <span class="shortcut-hint">Press <kbd>/</kbd> anytime to search</span>
          <span class="shortcut-divider">·</span>
          <a href={`${baseUrl}agent/`} class="ai-agent-shortcut">🤖 Or ask the Course AI Agent →</a>
        </div>
      </div>

      <!-- Advanced Filters -->
      <div class="search-controls">
        <div class="filter-tabs" id="type-tabs">
          <button class="filter-tab active" data-type="all">All</button>
          <button class="filter-tab" data-type="slide">📽️ Slides</button>
          <button class="filter-tab" data-type="lesson">📖 Lessons</button>
          <button class="filter-tab" data-type="bonus">⭐ Extras</button>
          <button class="filter-tab" data-type="homework">📝 Homeworks</button>
          <button class="filter-tab" data-type="code">💻 Code</button>
        </div>

        <div class="search-toggles">
          <label class="toggle-label" title="Enable typo tolerance with edit distance matching">
            <input type="checkbox" id="toggle-fuzzy" checked />
            <span>Fuzzy (Typo Tolerant)</span>
          </label>
          <label class="toggle-label" title="Expand queries with related Git & Bash synonyms">
            <input type="checkbox" id="toggle-semantic" checked />
            <span>Semantic Expansion</span>
          </label>
        </div>
      </div>

      <!-- Popular Quick Filters -->
      <div class="quick-tags-bar">
        <span class="quick-label">Quick topics:</span>
        <button class="tag-chip" data-query="staging area">staging area</button>
        <button class="tag-chip" data-query="git rebase -i">rebase</button>
        <button class="tag-chip" data-query="git branch">branching</button>
        <button class="tag-chip" data-query="merge conflict">conflicts</button>
        <button class="tag-chip" data-query="git internals blob tree">internals</button>
        <button class="tag-chip" data-query="git remotes push pull">remotes</button>
        <button class="tag-chip" data-query="chmod permissions">permissions</button>
        <button class="tag-chip" data-query="homework">homeworks</button>
        <button class="tag-chip" data-query="ssh-keygen">ssh keys</button>
      </div>
    </div>

    <!-- Search Status & Stats -->
    <div id="search-stats" class="search-stats-bar" style="display: none;">
      <span id="results-count">0 matches</span>
      <span id="results-time" class="text-muted"></span>
    </div>

    <!-- Results Container -->
    <div id="results-container" class="results-list">
      <!-- Loading indicator -->
      <div id="search-loading" class="terminal-loader">
        <span class="cursor-blink">></span> Loading course database (330+ slides)...
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { CourseSearchEngine } from '../../client/js/search-engine.js';
  import { baseUrl } from '../../lib/constants';

  let searchEngine = null;
  let currentType = 'all';
  let debounceTimeout = null;

  const searchInput = document.getElementById('search-input');
  const clearBtn = document.getElementById('clear-search-btn');
  const resultsContainer = document.getElementById('results-container');
  const statsBar = document.getElementById('search-stats');
  const resultsCount = document.getElementById('results-count');
  const resultsTime = document.getElementById('results-time');
  const toggleFuzzy = document.getElementById('toggle-fuzzy');
  const toggleSemantic = document.getElementById('toggle-semantic');
  const typeTabs = document.querySelectorAll('.filter-tab');
  const tagChips = document.querySelectorAll('.tag-chip');

  // Initialize Search Engine
  async function init() {
    try {
      searchEngine = new CourseSearchEngine();
      await searchEngine.load(`${baseUrl}search-data.json`);
      
      const loader = document.getElementById('search-loading');
      if (loader) loader.style.display = 'none';

      // Check URL parameters for query
      const urlParams = new URLSearchParams(window.location.search);
      const initialQuery = urlParams.get('q');
      if (initialQuery) {
        searchInput.value = initialQuery;
        clearBtn.style.display = 'block';
        performSearch(initialQuery);
      } else {
        renderDefaultOverview();
      }
    } catch (err) {
      console.error(err);
      resultsContainer.innerHTML = `
        <div class="error-box framed">
          <h3>Failed to load search data</h3>
          <p>Please refresh the page or make sure you are running a local dev server.</p>
        </div>
      `;
    }
  }

  function renderDefaultOverview() {
    if (!searchEngine || !searchEngine.metadata) return;
    const meta = searchEngine.metadata;

    statsBar.style.display = 'flex';
    resultsCount.textContent = `Indexed: ${meta.totalSlides} Reveal.js Slides · ${meta.totalLessons} Lessons · ${meta.totalBonus} Extras · ${meta.totalHomeworks} Homeworks`;
    resultsTime.textContent = '';

    resultsContainer.innerHTML = `
      <div class="empty-state-card framed">
        <h3>💡 Search Tips & Curriculum Overview</h3>
        <p>Type keywords to search through all materials, or jump into key topics below:</p>
        <div class="overview-grid">
          <div class="overview-col">
            <h4>📖 Core Git Lessons</h4>
            <ul class="clean-list">
              <li><a href="#" class="suggest-link" data-q="the terminal">0. The terminal & the shell</a></li>
              <li><a href="#" class="suggest-link" data-q="basic bash">1. Basic bash navigation</a></li>
              <li><a href="#" class="suggest-link" data-q="file system">2. Working with the file system</a></li>
              <li><a href="#" class="suggest-link" data-q="intro to git">3. Intro to git (Three Trees)</a></li>
              <li><a href="#" class="suggest-link" data-q="git commands">4. Basic git commands</a></li>
              <li><a href="#" class="suggest-link" data-q="git remotes">5. Working with remotes & GitHub</a></li>
              <li><a href="#" class="suggest-link" data-q="git branches">6. Git branches & HEAD</a></li>
              <li><a href="#" class="suggest-link" data-q="git merging rebase">7. Git merging & rebase</a></li>
              <li><a href="#" class="suggest-link" data-q="advanced git bisect stash">8. Advanced features (stash, bisect)</a></li>
              <li><a href="#" class="suggest-link" data-q="git workflows PR">9. Git workflows & PRs</a></li>
              <li><a href="#" class="suggest-link" data-q="bash scripting">10. Bash scripting</a></li>
              <li><a href="#" class="suggest-link" data-q="git internals blob tree">11. Git internals (plumbing)</a></li>
            </ul>
          </div>
          <div class="overview-col">
            <h4>🛠️ Frequently Searched Commands</h4>
            <div class="cmd-pill-grid">
              ${meta.commands.slice(0, 18).map(c => `
                <button class="cmd-pill" data-q="${c.command}">${c.command}</button>
              `).join('')}
            </div>
            <div class="ai-banner-mini framed">
              <h4>🤖 Have a specific question?</h4>
              <p>Our Course AI Agent can answer questions, explain concepts from the slides, and quiz you.</p>
              <a href="${baseUrl}agent/" class="button inline">Open Course AI Agent →</a>
            </div>
          </div>
        </div>
      </div>
    `;

    attachSuggestionListeners();
  }

  function attachSuggestionListeners() {
    document.querySelectorAll('.suggest-link, .cmd-pill').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const q = btn.getAttribute('data-q');
        searchInput.value = q;
        clearBtn.style.display = 'block';
        performSearch(q);
        searchInput.focus();
      });
    });
  }

  function performSearch(query) {
    if (!searchEngine) return;
    const q = (query || '').trim();
    if (!q) {
      statsBar.style.display = 'none';
      renderDefaultOverview();
      return;
    }

    const options = {
      type: currentType,
      fuzzy: toggleFuzzy.checked,
      semantic: toggleSemantic.checked,
      limit: 50,
    };

    const response = searchEngine.search(q, options);
    renderResults(response);
  }

  function renderResults(response) {
    const { results, total, query, executionTimeMs } = response;
    statsBar.style.display = 'flex';
    resultsCount.innerHTML = `Found <strong>${total}</strong> match${total === 1 ? '' : 'es'}`;
    resultsTime.textContent = `(${executionTimeMs} ms)`;

    if (total === 0) {
      resultsContainer.innerHTML = `
        <div class="no-results-card framed">
          <h3>No matching materials found for "${escapeHtml(query)}"</h3>
          <p>Try checking your spelling, unchecking filters, or searching for broader terms like <code>git</code>, <code>branch</code>, or <code>homework</code>.</p>
          <div class="ai-recommendation">
            <p>You can also ask the Course AI Agent to explain this concept:</p>
            <a href="${baseUrl}agent/?q=${encodeURIComponent(query)}" class="button inline">Ask AI Agent: "${escapeHtml(query)}" ↗</a>
          </div>
        </div>
      `;
      return;
    }

    const cardsHtml = results.map(res => {
      const item = res.item;
      const isSlide = item.type === 'slide';
      const isLesson = item.type === 'lesson';
      const isHomework = item.type === 'homework';
      const isBonus = item.type === 'bonus';
      const isSyllabus = item.type === 'syllabus';

      let typeBadge = '';
      if (isSlide) {
        typeBadge = `<span class="badge badge-slide">SLIDE #${item.slideIndex}</span>`;
      } else if (isLesson) {
        typeBadge = `<span class="badge badge-lesson">FULL LESSON ${item.order}</span>`;
      } else if (isHomework) {
        typeBadge = `<span class="badge badge-homework">HOMEWORK</span>`;
      } else if (isBonus) {
        typeBadge = `<span class="badge badge-bonus">EXTRAS</span>`;
      } else if (isSyllabus) {
        typeBadge = `<span class="badge badge-syllabus">SYLLABUS</span>`;
      }

      const parentInfo = item.parentTitle && item.parentTitle !== item.title
        ? `<div class="item-parent">${escapeHtml(item.parentTitle)}</div>`
        : '';

      const tagsHtml = item.tags && item.tags.length > 0
        ? `<div class="item-tags">${item.tags.map(t => `<span class="item-tag">#${escapeHtml(t)}</span>`).join('')}</div>`
        : '';

      const codeSnippetHtml = res.matchingCodeSnippet
        ? `<div class="item-code-preview">
            <div class="code-header">
              <span>Code Snippet</span>
              <button class="copy-code-btn" data-code="${escapeHtml(res.matchingCodeSnippet)}">Copy</button>
            </div>
            <pre><code>${escapeHtml(res.matchingCodeSnippet)}</code></pre>
          </div>`
        : '';

      // Direct Action Links
      let actionsHtml = '';
      if (isSlide) {
        actionsHtml = `
          <div class="card-actions">
            <a href="${item.url}" class="button inline btn-highlight" target="_blank">
              ▶ Open Slide in Reveal.js ↗
            </a>
            ${item.lessonUrl ? `<a href="${item.lessonUrl}" class="button inline outline">📖 Read Full Lesson</a>` : ''}
            <button class="button inline preview-slide-btn" data-id="${item.id}">👁️ Preview</button>
            <a href="${baseUrl}agent/?q=${encodeURIComponent('Explain slide: ' + item.title + ' from ' + (item.parentTitle || ''))}" class="button inline ask-ai-btn">🤖 Ask AI</a>
          </div>
        `;
      } else if (isLesson) {
        actionsHtml = `
          <div class="card-actions">
            <a href="${item.url}" class="button inline btn-highlight">📖 View Full Lesson</a>
            ${item.slidesUrl ? `<a href="${item.slidesUrl}" class="button inline outline" target="_blank">📽️ View Presentation ↗</a>` : ''}
            <a href="${baseUrl}agent/?q=${encodeURIComponent('Summarize lesson: ' + item.title)}" class="button inline ask-ai-btn">🤖 Ask AI</a>
          </div>
        `;
      } else {
        actionsHtml = `
          <div class="card-actions">
            <a href="${item.url}" class="button inline btn-highlight">Read Material</a>
            ${item.slidesUrl ? `<a href="${item.slidesUrl}" class="button inline outline" target="_blank">📽️ View Slides ↗</a>` : ''}
          </div>
        `;
      }

      // Hidden preview container for in-page slide view
      const previewDrawerHtml = isSlide
        ? `<div id="preview-${item.id}" class="inline-slide-preview framed" style="display: none;">
            <div class="preview-header">
              <strong>${escapeHtml(item.title)}</strong>
              <button class="close-preview-btn" data-target="preview-${item.id}">✕ Close</button>
            </div>
            <div class="preview-body">${formatMarkdownSimple(item.rawMarkdown)}</div>
          </div>`
        : '';

      return `
        <article class="result-card framed" id="card-${item.id}">
          <div class="card-top-meta">
            ${typeBadge}
            ${parentInfo}
          </div>
          <h2 class="result-title">
            <a href="${item.url}" ${isSlide ? 'target="_blank"' : ''}>${res.highlightedTitle}</a>
          </h2>
          <div class="result-snippet">
            <p>${res.highlightedSnippet}</p>
          </div>
          ${codeSnippetHtml}
          ${tagsHtml}
          ${actionsHtml}
          ${previewDrawerHtml}
        </article>
      `;
    }).join('');

    resultsContainer.innerHTML = cardsHtml;
    attachResultEventListeners();
  }

  function attachResultEventListeners() {
    // Copy code button
    document.querySelectorAll('.copy-code-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const code = btn.getAttribute('data-code');
        navigator.clipboard.writeText(code).then(() => {
          const original = btn.textContent;
          btn.textContent = 'Copied!';
          setTimeout(() => btn.textContent = original, 1500);
        });
      });
    });

    // Preview slide inline drawer
    document.querySelectorAll('.preview-slide-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-id');
        const drawer = document.getElementById(`preview-${id}`);
        if (drawer) {
          const isShown = drawer.style.display !== 'none';
          drawer.style.display = isShown ? 'none' : 'block';
          btn.textContent = isShown ? '👁️ Preview' : '👁️ Hide';
        }
      });
    });

    // Close preview button
    document.querySelectorAll('.close-preview-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');
        const drawer = document.getElementById(targetId);
        if (drawer) {
          drawer.style.display = 'none';
          const cardId = targetId.replace('preview-', '');
          const pBtn = document.querySelector(`.preview-slide-btn[data-id="${cardId}"]`);
          if (pBtn) pBtn.textContent = '👁️ Preview';
        }
      });
    });
  }

  function formatMarkdownSimple(md) {
    if (!md) return '';
    return md
      .replace(/^### (.*$)/gim, '<h3>$1</h3>')
      .replace(/^## (.*$)/gim, '<h2>$1</h2>')
      .replace(/^# (.*$)/gim, '<h1>$1</h1>')
      .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
      .replace(/`([^`]+)`/g, '<code>$1</code>')
      .replace(/```(?:[a-zA-Z0-9_-]*)\r?\n([\s\S]*?)```/g, '<pre><code>$1</code></pre>')
      .replace(/\n\n/g, '<br/><br/>');
  }

  function escapeHtml(str) {
    if (!str) return '';
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  // Event Listeners
  searchInput.addEventListener('input', (e) => {
    const val = e.target.value;
    clearBtn.style.display = val ? 'block' : 'none';
    clearTimeout(debounceTimeout);
    debounceTimeout = setTimeout(() => {
      performSearch(val);
    }, 150);
  });

  clearBtn.addEventListener('click', () => {
    searchInput.value = '';
    clearBtn.style.display = 'none';
    searchInput.focus();
    performSearch('');
  });

  // Global '/' keyboard shortcut to focus search input
  window.addEventListener('keydown', (e) => {
    if (e.key === '/' && document.activeElement !== searchInput) {
      e.preventDefault();
      searchInput.focus();
      searchInput.select();
    }
  });

  // Filter tabs
  typeTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      typeTabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      currentType = tab.getAttribute('data-type');
      performSearch(searchInput.value);
    });
  });

  // Toggles
  toggleFuzzy.addEventListener('change', () => performSearch(searchInput.value));
  toggleSemantic.addEventListener('change', () => performSearch(searchInput.value));

  // Quick tag chips
  tagChips.forEach(chip => {
    chip.addEventListener('click', () => {
      const q = chip.getAttribute('data-query');
      searchInput.value = q;
      clearBtn.style.display = 'block';
      performSearch(q);
      searchInput.focus();
    });
  });

  // Start initialization
  init();
</script>

<style>
  .search-page-container {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-bottom: 60px;
  }

  .search-hero {
    background-color: var(--background);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .terminal-badge {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--background);
    background-color: var(--accent);
    padding: 2px 8px;
    display: inline-block;
    margin-bottom: 8px;
  }

  .page-title {
    font-size: 1.8rem;
    color: var(--accent);
    margin: 4px 0 8px 0;
  }

  .hero-desc {
    color: var(--foreground);
    opacity: 0.9;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  /* Search Input */
  .search-box-wrapper {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 6px;
  }

  .search-input-group {
    display: flex;
    align-items: center;
    border: 2px solid var(--accent);
    background-color: rgba(0, 0, 0, 0.4);
    padding: 6px 12px;
    gap: 10px;
  }

  .prompt-symbol {
    font-weight: bold;
    color: var(--accent);
    font-size: 1.3rem;
  }

  .search-input {
    flex: 1;
    background: transparent;
    border: none;
    color: var(--foreground);
    font-family: inherit;
    font-size: 1.1rem;
    outline: none;
  }

  .search-input::placeholder {
    color: rgba(236, 234, 229, 0.45);
    font-size: 0.95rem;
  }

  .clear-btn {
    background: transparent;
    border: none;
    color: var(--accent);
    cursor: pointer;
    font-size: 1.2rem;
    padding: 0 4px;
  }

  .search-shortcuts {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.85rem;
    color: rgba(236, 234, 229, 0.7);
  }

  kbd {
    border: 1px solid var(--accent);
    padding: 1px 6px;
    font-family: inherit;
    color: var(--accent);
  }

  .ai-agent-shortcut {
    color: var(--secondary);
    text-decoration: none;
    font-weight: 600;
  }

  .ai-agent-shortcut:hover {
    text-decoration: underline;
  }

  /* Filter Controls */
  .search-controls {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    border-top: 1px solid rgba(105, 236, 145, 0.25);
    padding-top: 12px;
  }

  .filter-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .filter-tab {
    background: transparent;
    border: 1px solid rgba(105, 236, 145, 0.4);
    color: var(--foreground);
    padding: 4px 10px;
    cursor: pointer;
    font-family: inherit;
    font-size: 0.85rem;
    transition: all 0.15s ease;
  }

  .filter-tab.active {
    background: var(--accent);
    color: var(--background);
    font-weight: bold;
    border-color: var(--accent);
  }

  .search-toggles {
    display: flex;
    gap: 14px;
    font-size: 0.85rem;
  }

  .toggle-label {
    display: flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    color: rgba(236, 234, 229, 0.85);
  }

  .toggle-label input {
    accent-color: var(--accent);
  }

  /* Quick Tags Bar */
  .quick-tags-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
  }

  .quick-label {
    color: var(--secondary);
    font-size: 0.8rem;
    margin-right: 4px;
  }

  .tag-chip {
    background: transparent;
    border: 1px dashed rgba(246, 231, 178, 0.5);
    color: var(--secondary);
    padding: 2px 8px;
    font-size: 0.8rem;
    cursor: pointer;
    font-family: inherit;
  }

  .tag-chip:hover {
    background: rgba(246, 231, 178, 0.15);
  }

  /* Stats Bar */
  .search-stats-bar {
    display: flex;
    justify-content: space-between;
    font-size: 0.85rem;
    color: var(--accent);
    padding: 0 4px;
  }

  .text-muted {
    color: rgba(236, 234, 229, 0.5);
  }

  /* Results List */
  .results-list {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .result-card {
    background: var(--background);
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    border: 2px solid rgba(105, 236, 145, 0.4);
    transition: border-color 0.15s ease;
  }

  .result-card:hover {
    border-color: var(--accent);
  }

  .card-top-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.8rem;
  }

  .badge {
    padding: 2px 6px;
    font-weight: 700;
    font-size: 0.75rem;
  }

  .badge-slide {
    background: var(--accent);
    color: var(--background);
  }

  .badge-lesson {
    background: var(--secondary);
    color: var(--background);
  }

  .badge-homework {
    background: #ff7b72;
    color: #1a170f;
  }

  .badge-bonus {
    background: #d2a8ff;
    color: #1a170f;
  }

  .badge-syllabus {
    background: #79c0ff;
    color: #1a170f;
  }

  .item-parent {
    color: rgba(236, 234, 229, 0.6);
  }

  .result-title {
    font-size: 1.25rem;
    margin: 0;
  }

  .result-title a {
    color: var(--accent);
    text-decoration: none;
  }

  .result-title a:hover {
    text-decoration: underline;
  }

  .result-snippet p {
    color: var(--foreground);
    font-size: 0.95rem;
    line-height: 1.5;
