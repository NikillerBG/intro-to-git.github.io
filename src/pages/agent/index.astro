---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { baseUrl } from '../../helpers.astro';
---

<BaseLayout title="AI Course Assistant - COS 3100: Intro to Git">
  <div class="agent-page-container">
    <!-- Terminal Header & Configuration Bar -->
    <div class="agent-hero framed">
      <div class="hero-top-row">
        <div>
          <span class="terminal-badge">COS 3100 TEACHING ASSISTANT</span>
          <h1 class="agent-title">GitBot: Course AI Assistant</h1>
        </div>
        <div class="engine-indicator-wrapper">
          <button id="engine-settings-btn" class="button inline outline engine-btn" title="Configure AI Provider">
            <span id="current-engine-pill">⚡ Built-in Agent</span>
            <span class="gear-icon">⚙️</span>
          </button>
        </div>
      </div>
      <p class="agent-desc">
        Grounded in all <strong>330+ Reveal.js presentation slides</strong>, 13 lessons, homework assignments,
        and bonus Linux materials taught by Mihail Mikov.
      </p>

      <!-- Suggested Starter Questions -->
      <div class="starter-chips">
        <span class="chips-label">Quick prompts:</span>
        <button class="chip" data-q="Explain the 3 Git Trees (Working Directory, Staging, Repository)">🌳 Three Trees</button>
        <button class="chip" data-q="What is the difference between git merge and git rebase?">🔀 Merge vs Rebase</button>
        <button class="chip" data-q="How do I complete Homework 1 step-by-step?">📝 Homework 1 Guide</button>
        <button class="chip" data-q="Explain Git internals: blobs, trees, commits, and tags">🔍 Git Objects</button>
        <button class="chip" data-q="How do I resolve a merge conflict?">💥 Merge Conflicts</button>
        <button class="chip" data-q="Explain file permissions chmod 755 vs 644">🔒 Chmod Permissions</button>
        <button class="chip chip-quiz" data-q="quiz me on git">📝 Quiz Me!</button>
      </div>
    </div>

    <!-- Chat Messages Window -->
    <div class="chat-terminal-box framed">
      <div class="terminal-topbar">
        <span class="terminal-dots">● ● ●</span>
        <span class="terminal-session">cos3100_ai_session://aubg.edu/gitbot</span>
        <button id="clear-chat-btn" class="terminal-action-btn" title="Clear conversation history">Clear</button>
      </div>

      <div id="messages-container" class="messages-stream">
        <!-- Initial Welcome Message -->
        <div class="message-row bot-row">
          <div class="avatar">🤖</div>
          <div class="message-bubble bot-bubble">
            <div class="bubble-header">
              <span class="sender-name">GitBot (COS 3100 Assistant)</span>
              <span class="timestamp">Ready</span>
            </div>
            <div class="bubble-content">
              <p>Welcome! I'm your interactive AI teaching assistant for <strong>COS 3100: Intro to Git</strong> at AUBG.</p>
              <p>I have indexed all <strong>13 lessons, 330+ Reveal.js slides, homeworks, and bonus materials</strong>. You can ask me to:</p>
              <ul>
                <li>Explain any Git or Bash command/concept with exact slide citations.</li>
                <li>Troubleshoot problems like merge conflicts or detached HEAD.</li>
                <li>Guide you through <strong>Homework 1</strong> (SSH, GitHub Pages) or <strong>Homework 2</strong> (PRs, collaboration).</li>
                <li>Quiz you interactively to test your knowledge before exams!</li>
              </ul>
              <p class="hint-text">Type your question below or click one of the quick prompts above.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Live Typing / Processing Indicator -->
      <div id="typing-indicator" class="typing-indicator" style="display: none;">
        <span class="typing-cursor">></span> GitBot is searching course slides and thinking...
      </div>

      <!-- Chat Input Area -->
      <div class="chat-input-container">
        <div class="input-line">
          <span class="cli-prompt">student@aubg:~$</span>
          <textarea
            id="chat-textarea"
            rows="1"
            placeholder="Ask a question about the course, slides, homework, or commands..."
            spellcheck="false"
          ></textarea>
          <button id="send-msg-btn" class="send-btn" title="Send message (Enter)">↵ Send</button>
        </div>
        <div class="input-footer">
          <span>Press <kbd>Enter</kbd> to send, <kbd>Shift + Enter</kbd> for newline</span>
          <a href={`${baseUrl}search/`} class="search-link">🔍 Prefer standard keyword search?</a>
        </div>
      </div>
    </div>

    <!-- Engine Settings Modal -->
    <div id="settings-modal" class="settings-modal-overlay" style="display: none;">
      <div class="settings-modal-card framed">
        <div class="modal-header">
          <h3>⚙️ AI Agent Settings</h3>
          <button id="close-modal-btn" class="close-modal-btn">✕</button>
        </div>
        <div class="modal-body">
          <p class="modal-desc">
            You can use the built-in local engine (instant, zero configuration), or connect your own
            free Google Gemini API key or local Ollama instance for frontier generative reasoning.
          </p>

          <div class="setting-group">
            <label class="setting-label">AI Provider:</label>
            <select id="provider-select" class="terminal-select">
              <option value="builtin">⚡ Built-in Agent (Local, Free, Instant, 0 Setup)</option>
              <option value="gemini">✨ Google Gemini (Free API Key from Google AI Studio)</option>
              <option value="openai">🧠 OpenAI (GPT-4o-mini)</option>
              <option value="ollama">🦙 Local Ollama (http://localhost:11434)</option>
            </select>
          </div>

          <!-- Gemini Config Fields -->
          <div id="gemini-fields" class="provider-fields" style="display: none;">
            <div class="setting-group">
              <label class="setting-label">Gemini API Key:</label>
              <input type="password" id="gemini-key-input" class="terminal-input" placeholder="AIzaSy..." />
              <span class="setting-help">Get a free key from <a href="https://aistudio.google.com/app/apikey" target="_blank">Google AI Studio ↗</a>. Stored only in your browser localStorage.</span>
            </div>
            <div class="setting-group">
              <label class="setting-label">Gemini Model:</label>
              <select id="gemini-model-select" class="terminal-select">
                <option value="gemini-3.8-flash">gemini-3.8-flash (Recommended, latest & fast)</option>
                <option value="gemini-2.5-flash">gemini-2.5-flash</option>
                <option value="gemini-1.5-flash">gemini-1.5-flash</option>
                <option value="gemini-1.5-pro">gemini-1.5-pro (Deep reasoning)</option>
              </select>
            </div>
          </div>

          <!-- OpenAI Config Fields -->
          <div id="openai-fields" class="provider-fields" style="display: none;">
            <div class="setting-group">
              <label class="setting-label">OpenAI API Key:</label>
              <input type="password" id="openai-key-input" class="terminal-input" placeholder="sk-..." />
            </div>
            <div class="setting-group">
              <label class="setting-label">OpenAI Model:</label>
              <select id="openai-model-select" class="terminal-select">
                <option value="gpt-4o-mini">gpt-4o-mini</option>
                <option value="gpt-4o">gpt-4o</option>
              </select>
            </div>
          </div>

          <!-- Ollama Config Fields -->
          <div id="ollama-fields" class="provider-fields" style="display: none;">
            <div class="setting-group">
              <label class="setting-label">Ollama Host URL:</label>
              <input type="text" id="ollama-url-input" class="terminal-input" value="http://localhost:11434" />
            </div>
            <div class="setting-group">
              <label class="setting-label">Model Name:</label>
              <input type="text" id="ollama-model-input" class="terminal-input" value="llama3.2" placeholder="e.g. llama3.2, mistral, qwen2.5" />
            </div>
          </div>
        </div>

        <div class="modal-footer">
          <button id="save-settings-btn" class="button inline btn-highlight">Save Configuration</button>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { CourseSearchEngine } from '../../client/js/search-engine.js';
  import { CourseAIAgent } from '../../client/js/agent-engine.js';
  import { baseUrl } from '../../lib/constants';

  let searchEngine = null;
  let aiAgent = null;

  const messagesContainer = document.getElementById('messages-container');
  const chatTextarea = document.getElementById('chat-textarea');
  const sendBtn = document.getElementById('send-msg-btn');
  const typingIndicator = document.getElementById('typing-indicator');
  const clearChatBtn = document.getElementById('clear-chat-btn');
  const starterChips = document.querySelectorAll('.chip');
  const enginePill = document.getElementById('current-engine-pill');

  // Modal elements
  const settingsModal = document.getElementById('settings-modal');
  const engineSettingsBtn = document.getElementById('engine-settings-btn');
  const closeModalBtn = document.getElementById('close-modal-btn');
  const saveSettingsBtn = document.getElementById('save-settings-btn');
  const providerSelect = document.getElementById('provider-select');
  const geminiFields = document.getElementById('gemini-fields');
  const openaiFields = document.getElementById('openai-fields');
  const ollamaFields = document.getElementById('ollama-fields');
  const geminiKeyInput = document.getElementById('gemini-key-input');
  const geminiModelSelect = document.getElementById('gemini-model-select');
  const openaiKeyInput = document.getElementById('openai-key-input');
  const openaiModelSelect = document.getElementById('openai-model-select');
  const ollamaUrlInput = document.getElementById('ollama-url-input');
  const ollamaModelInput = document.getElementById('ollama-model-input');

  async function init() {
    searchEngine = new CourseSearchEngine();
    await searchEngine.load(`${baseUrl}search-data.json`);

    aiAgent = new CourseAIAgent(searchEngine);
    updateEnginePill();

    // Check for URL query parameter e.g. ?q=...
    const urlParams = new URLSearchParams(window.location.search);
    const initialQ = urlParams.get('q');
    if (initialQ) {
      chatTextarea.value = initialQ;
      handleSendMessage();
    }
  }

  function updateEnginePill() {
    if (!aiAgent) return;
    const provider = aiAgent.config.provider;
    if (provider === 'gemini') {
      enginePill.textContent = '✨ Gemini AI';
    } else if (provider === 'openai') {
      enginePill.textContent = '🧠 OpenAI';
    } else if (provider === 'ollama') {
      enginePill.textContent = '🦙 Ollama Local';
    } else {
      enginePill.textContent = '⚡ Built-in Agent';
    }
  }

  async function handleSendMessage() {
    const text = chatTextarea.value.trim();
    if (!text || !aiAgent) return;

    // Append User Message
    appendMessage('user', text);
    chatTextarea.value = '';
    chatTextarea.style.height = 'auto';

    // Show typing indicator
    typingIndicator.style.display = 'block';
    scrollToBottom();

    // Create placeholder for bot message
    const botMsgEl = createBotMessageElement();
    messagesContainer.appendChild(botMsgEl);
    const contentEl = botMsgEl.querySelector('.bubble-content');

    try {
      const response = await aiAgent.ask(text, (streamedText) => {
        contentEl.innerHTML = formatMarkdown(streamedText);
        scrollToBottom();
      });

      typingIndicator.style.display = 'none';

      if (response.type === 'quiz') {
        renderQuizCard(botMsgEl, response.quiz);
      } else {
        contentEl.innerHTML = formatMarkdown(response.text);
        if (response.citations && response.citations.length > 0) {
          renderCitations(botMsgEl, response.citations);
        }
      }
    } catch (err) {
      typingIndicator.style.display = 'none';
      // Automatic seamless fallback to Built-in Course Engine
      try {
        const relevantItems = searchEngine.search(text, { type: 'all', limit: 6, semantic: true, fuzzy: true }).results.map(r => r.item);
        const fallback = await aiAgent.askBuiltin(text, relevantItems, (streamedText) => {
          contentEl.innerHTML = formatMarkdown(streamedText);
          scrollToBottom();
        });
        contentEl.innerHTML = `
          <div class="cloud-fallback-banner">
            ⚠️ <em>Cloud API note: ${escapeHtml(err.message || 'Connection failed (often blocked by ad-blocker or Brave Shields)')}. Answering via <strong>⚡ Built-in Course Engine</strong>:</em>
          </div>
        ` + formatMarkdown(fallback.text);
        if (fallback.citations && fallback.citations.length > 0) {
          renderCitations(botMsgEl, fallback.citations);
        }
      } catch (fallbackErr) {
        contentEl.innerHTML = `
          <div class="error-inline">
            <p>⚠️ <strong>Error:</strong> ${escapeHtml(err.message || 'Something went wrong.')}</p>
            <p>Switch to the <strong>⚡ Built-in Agent</strong> in Settings (⚙️).</p>
          </div>
        `;
      }
    }

    attachCodeCopyListeners();
    scrollToBottom();
  }

  function appendMessage(sender, text) {
    const row = document.createElement('div');
    row.className = `message-row ${sender}-row`;

    if (sender === 'user') {
      row.innerHTML = `
        <div class="message-bubble user-bubble">
          <div class="bubble-header">
            <span class="sender-name">You</span>
            <span class="timestamp">${getCurrentTime()}</span>
          </div>
          <div class="bubble-content">
            <p>${escapeHtml(text)}</p>
          </div>
        </div>
        <div class="avatar user-avatar">👤</div>
      `;
    }
    messagesContainer.appendChild(row);
    scrollToBottom();
  }

  function createBotMessageElement() {
    const row = document.createElement('div');
    row.className = 'message-row bot-row';
    row.innerHTML = `
      <div class="avatar">🤖</div>
      <div class="message-bubble bot-bubble">
        <div class="bubble-header">
          <span class="sender-name">GitBot</span>
          <span class="timestamp">${getCurrentTime()}</span>
        </div>
        <div class="bubble-content">
          <span class="cursor-blink">></span> Retrieving slides and generating answer...
        </div>
      </div>
    `;
    return row;
  }

  function renderCitations(container, citations) {
    const wrapper = document.createElement('div');
    wrapper.className = 'citations-wrapper';
    wrapper.innerHTML = `
      <div class="citations-title">📚 Course References & Slide Links:</div>
      <div class="citations-list">
        ${citations.map(c => `
          <a href="${c.url}" class="citation-badge" target="_blank" title="Open ${escapeHtml(c.title)}">
            ${c.type === 'slide' ? '📽️ Slide' : '📖 Lesson'}: ${escapeHtml(c.title)} ↗
          </a>
        `).join('')}
      </div>
    `;
    container.querySelector('.message-bubble').appendChild(wrapper);
  }

  function renderQuizCard(container, quiz) {
    const contentEl = container.querySelector('.bubble-content');
    contentEl.innerHTML = `
      <div class="quiz-card framed">
        <div class="quiz-badge">KNOWLEDGE CHECK</div>
        <p class="quiz-question">${escapeHtml(quiz.question)}</p>
        <div class="quiz-options">
          ${quiz.options.map((opt, i) => `
            <button class="quiz-opt-btn" data-index="${i}">
              <span class="opt-letter">${String.fromCharCode(65 + i)}.</span> ${escapeHtml(opt)}
            </button>
          `).join('')}
        </div>
        <div class="quiz-feedback" style="display: none;"></div>
      </div>
    `;

    const optBtns = contentEl.querySelectorAll('.quiz-opt-btn');
    const feedbackEl = contentEl.querySelector('.quiz-feedback');

    optBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const selectedIdx = parseInt(btn.getAttribute('data-index'), 10);
        optBtns.forEach(b => b.disabled = true);

        if (selectedIdx === quiz.correct) {
          btn.classList.add('correct');
          feedbackEl.innerHTML = `
            <div class="feedback-box correct-box">
              <strong>🎉 Correct!</strong>
              <p>${escapeHtml(quiz.explanation)}</p>
              <div class="quiz-slide-link">
                <a href="${quiz.slideUrl}" class="button inline" target="_blank">Review in Reveal.js Slide (${escapeHtml(quiz.lessonTitle)}) ↗</a>
                <button class="button inline next-quiz-btn">Next Quiz Question →</button>
              </div>
            </div>
          `;
        } else {
          btn.classList.add('incorrect');
          optBtns[quiz.correct].classList.add('correct');
          feedbackEl.innerHTML = `
            <div class="feedback-box incorrect-box">
              <strong>❌ Incorrect</strong>
              <p>${escapeHtml(quiz.explanation)}</p>
              <div class="quiz-slide-link">
                <a href="${quiz.slideUrl}" class="button inline" target="_blank">Review in Reveal.js Slide (${escapeHtml(quiz.lessonTitle)}) ↗</a>
                <button class="button inline next-quiz-btn">Try Another Question →</button>
              </div>
            </div>
          `;
        }

        feedbackEl.style.display = 'block';
        const nextBtn = feedbackEl.querySelector('.next-quiz-btn');
        if (nextBtn) {
          nextBtn.addEventListener('click', () => {
            chatTextarea.value = 'quiz me on git';
            handleSendMessage();
          });
        }
        scrollToBottom();
      });
    });
  }

  function formatMarkdown(md) {
    if (!md) return '';
    return md
      .replace(/^### (.*$)/gim, '<h3>$1</h3>')
      .replace(/^## (.*$)/gim, '<h2>$1</h2>')
      .replace(/^# (.*$)/gim, '<h1>$1</h1>')
      .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
      .replace(/\*(.*?)\*/g, '<em>$1</em>')
      .replace(/`([^`]+)`/g, '<code>$1</code>')
      .replace(/```(?:[a-zA-Z0-9_-]*)\r?\n([\s\S]*?)```/g, (match, code) => {
        return `
          <div class="code-container">
            <div class="code-bar">
              <span>Code</span>
              <button class="copy-btn" data-code="${escapeHtml(code.trim())}">Copy</button>
            </div>
            <pre><code>${escapeHtml(code.trim())}</code></pre>
          </div>
        `;
      })
      .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" class="chat-link">$1 ↗</a>')
      .replace(/\n\n/g, '<br/><br/>')
      .replace(/\n- (.*$)/gim, '<li>$1</li>');
  }

  function attachCodeCopyListeners() {
    document.querySelectorAll('.copy-btn').forEach(btn => {
      btn.onclick = () => {
        const code = btn.getAttribute('data-code');
        navigator.clipboard.writeText(code).then(() => {
          const orig = btn.textContent;
          btn.textContent = 'Copied!';
          setTimeout(() => btn.textContent = orig, 1500);
        });
      };
    });
  }

  function escapeHtml(str) {
    if (!str) return '';
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function getCurrentTime() {
    const d = new Date();
    return d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
  }

  function scrollToBottom() {
    messagesContainer.scrollTop = messagesContainer.scrollHeight;
  }

  // Event Listeners
  sendBtn.addEventListener('click', handleSendMessage);

  chatTextarea.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      handleSendMessage();
    }
  });

  // Auto expand textarea
  chatTextarea.addEventListener('input', () => {
    chatTextarea.style.height = 'auto';
    chatTextarea.style.height = Math.min(chatTextarea.scrollHeight, 120) + 'px';
  });

  clearChatBtn.addEventListener('click', () => {
    messagesContainer.innerHTML = '';
    init();
  });

  starterChips.forEach(chip => {
    chip.addEventListener('click', () => {
      const q = chip.getAttribute('data-q');
      chatTextarea.value = q;
      handleSendMessage();
    });
  });

  // Settings Modal handlers
  engineSettingsBtn.addEventListener('click', () => {
    const cfg = aiAgent.config;
    providerSelect.value = cfg.provider;
    geminiKeyInput.value = cfg.apiKey && cfg.provider === 'gemini' ? cfg.apiKey : '';
    openaiKeyInput.value = cfg.apiKey && cfg.provider === 'openai' ? cfg.apiKey : '';
    let currentGeminiModel = cfg.model || 'gemini-3.8-flash';
    if (currentGeminiModel === 'gemini-2.0-flash') currentGeminiModel = 'gemini-3.8-flash';
    geminiModelSelect.value = currentGeminiModel;
    openaiModelSelect.value = cfg.model || 'gpt-4o-mini';
    ollamaUrlInput.value = cfg.ollamaUrl || 'http://localhost:11434';
    ollamaModelInput.value = cfg.ollamaModel || 'llama3.2';
    updateModalFields(cfg.provider);
    settingsModal.style.display = 'flex';
  });

  closeModalBtn.addEventListener('click', () => {
    settingsModal.style.display = 'none';
  });

  providerSelect.addEventListener('change', (e) => {
    updateModalFields(e.target.value);
  });

  function updateModalFields(provider) {
    geminiFields.style.display = provider === 'gemini' ? 'block' : 'none';
    openaiFields.style.display = provider === 'openai' ? 'block' : 'none';
    ollamaFields.style.display = provider === 'ollama' ? 'block' : 'none';
  }

  saveSettingsBtn.addEventListener('click', () => {
    const provider = providerSelect.value;
    let apiKey = '';
    let model = '';

    if (provider === 'gemini') {
      apiKey = geminiKeyInput.value.trim();
      model = geminiModelSelect.value;
    } else if (provider === 'openai') {
      apiKey = openaiKeyInput.value.trim();
      model = openaiModelSelect.value;
    }

    aiAgent.saveConfig({
      provider,
      apiKey,
      model,
      ollamaUrl: ollamaUrlInput.value.trim(),
      ollamaModel: ollamaModelInput.value.trim(),
    });

    updateEnginePill();
    settingsModal.style.display = 'none';
  });

  // Run initialization
  init();
</script>

<style>
  .agent-page-container {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-bottom: 50px;
  }

  .agent-hero {
    background-color: var(--background);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .hero-top-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 10px;
  }

  .terminal-badge {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--background);
    background-color: var(--accent);
    padding: 2px 8px;
    display: inline-block;
    margin-bottom: 6px;
  }

  .agent-title {
    font-size: 1.8rem;
    color: var(--accent);
    margin: 0;
  }

  .agent-desc {
    color: var(--foreground);
    opacity: 0.9;
    font-size: 0.95rem;
    line-height: 1.5;
    margin: 0;
  }

  .engine-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 4px 10px;
    font-size: 0.85rem;
  }

  /* Starter Prompt Chips */
  .starter-chips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    border-top: 1px solid rgba(105, 236, 145, 0.25);
    padding-top: 12px;
  }

  .chips-label {
    color: var(--secondary);
    font-size: 0.8rem;
  }

  .chip {
    background: transparent;
    border: 1px solid rgba(105, 236, 145, 0.5);
    color: var(--foreground);
    padding: 4px 10px;
    font-size: 0.8rem;
    cursor: pointer;
    font-family: inherit;
    transition: all 0.15s ease;
  }

  .chip:hover {
    background: rgba(105, 236, 145, 0.15);
    border-color: var(--accent);
    color: var(--accent);
  }

  .chip-quiz {
    border-color: var(--secondary);
    color: var(--secondary);
    font-weight: bold;
  }

  .chip-quiz:hover {
    background: rgba(246, 231, 178, 0.2);
  }

  /* Chat Terminal Box */
  .chat-terminal-box {
    background: rgba(15, 13, 8, 0.95);
    display: flex;
    flex-direction: column;
    min-height: 520px;
    padding: 0;
    overflow: hidden;
  }

  .terminal-topbar {
    background: #110e08;
    border-bottom: 1px solid rgba(105, 236, 145, 0.3);
    padding: 8px 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.8rem;
  }

  .terminal-dots {
    color: var(--accent);
    letter-spacing: 2px;
  }

  .terminal-session {
